@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":MainApp" as MainApp USER_COLOR

box Storage STORAGE_COLOR_T1
participant ":StorageManager" as StorageManager STORAGE_COLOR
participant ":JsonAddressBookStorage" as JsonAddressBookStorage STORAGE_COLOR
participant ":JsonSerializableAddressBook" as JsonSerializableAddressBook STORAGE_COLOR
end box

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
end box

[-> MainApp : init()
activate MainApp
MainApp -> MainApp : initModelManager(storage, userPrefs)
activate MainApp
MainApp -> StorageManager : readAddressBook()
activate StorageManager
StorageManager -> JsonAddressBookStorage : readAddressBook()
activate JsonAddressBookStorage
note right of JsonAddressBookStorage
Read the JSON file. A missing file returns
Optional.empty(). An unreadable file or
invalid JSON throws DataLoadingException.
end note
JsonAddressBookStorage -> JsonSerializableAddressBook : toModelType()
activate JsonSerializableAddressBook
note right of JsonSerializableAddressBook
Convert records in file order. The first
invalid record or duplicate Student ID
throws an exception.
end note
JsonSerializableAddressBook --> JsonAddressBookStorage : addressBook
deactivate JsonSerializableAddressBook
JsonAddressBookStorage --> StorageManager : Optional.of(addressBook)
deactivate JsonAddressBookStorage
StorageManager --> MainApp : Optional.of(addressBook)
deactivate StorageManager

alt file loaded
MainApp -> MainApp : startupMessage = "N students loaded."
else no data file
MainApp -> MainApp : startupMessage = "No existing student data found. ..."
else DataLoadingException
MainApp -> MainApp : isStudentDataAvailable = false\nstartupMessage = exception message
note right of MainApp
Start with an empty AddressBook.
The data file is not modified.
end note
end

create ModelManager
MainApp -> ModelManager : new ModelManager(initialData, userPrefs)
MainApp --> MainApp : model
deactivate MainApp

MainApp -> MainApp : initLogic(model, storage)
activate MainApp
create LogicManager
MainApp -> LogicManager : new LogicManager(model, storage,\nisStudentDataAvailable, startupMessage)
MainApp --> MainApp : logic
deactivate MainApp
[<-- MainApp
deactivate MainApp
@enduml
